PIHOLE_BASE_URL=http://192.168.1.x:80
# Pi-holeの管理画面のURL。監視の一覧で「理由」を押したとき、その通信だけを絞り込んだ
# クエリログを開くのに使う。**開くのはブラウザ**なので、上のURLがコンテナからしか
# 引けない名前（http://pihole:80 など）のときはここにLANのIPを入れる。
# 未設定なら PIHOLE_BASE_URL をそのまま使う
#PIHOLE_WEB_URL=http://192.168.1.x:80
PIHOLE_PASSWORD=your-password-here
PIHOLE_QUERY_LIMIT=-1
CLAUDE_TIMEOUT=60

# ---- DNSクエリの取り込み（「ブロックされていない怪しい通信」を見るための蓄積）----
# 既定のままで動く。止めたいときだけ false にする
#DNS_INGEST_ENABLED=true
# 取り込みの周期（秒）。短くしてもPi-holeを叩く回数が増えるだけで、得られる情報は変わらない
#DNS_INGEST_INTERVAL=300
# 生のクエリを何日ぶん残すか。長くして効くのは周期（ビーコン）の検出で、
# 初出の判定は保持期間に関係なく効く（ドメインの初出は別に持っているため）
#DNS_RETENTION_DAYS=7
# 起動時に何日ぶん遡ってドメインの初出を埋めるか。
# **0にすると「初日はすべてが初出」になる**。集計の口を使うので1日1リクエスト・約60KBと軽い
#DNS_BACKFILL_DAYS=30


# 「AIに聞く」でChiezo（LAN内の知識サーバー）を使う場合の**ルートURL**。
# 入れると、聞く相手（Claude Code / Codex / …）を画面から選べる。鍵はChiezoが持っている。
# **`/v1` は付けない**（こちらが `/v1/ai/...` を足すので、付けると404になる）。
# 値は「**このコンテナから**Chiezoに届くアドレス」——`localhost` はコンテナ自身を指すので不可。
# 空なら従来どおりCLIブリッジ（Claude Code）だけで動く
#CHIEZO_BASE_URL=http://192.168.1.x:7010
# Chiezo越しの1回の生成の上限（秒）。相手はCLIなので長めにしてある
#CHIEZO_TIMEOUT=180

# 行の「詳しく調べる」1回の上限（秒）。**web検索を伴うのでずっと長い** ——
# 1〜2文のメモを書かせるのとは桁が違う（実測30秒）
#INVESTIGATE_TIMEOUT=300

# 「AIに聞く」でCLIブリッジ（別コンテナ）を使うときの設定。既定のままでよい
#CLAUDE_BRIDGE_URL=http://bridge:7013/v1
#BRIDGE_IMAGE=ghcr.io/rtcode337/chiezo-bridge:latest

# 特定のイメージに固定・切り戻したいとき(既定はGHCRのlatest)
#PIHOLE_MONITOR_IMAGE=ghcr.io/rtcode337/pihole-monitor:sha-1234567

# data/ を読み書きするホスト側ユーザーの `id -u` / `id -g`。
# 1000以外のホストでだけ設定する(所有者合わせは起動時に自動で行われる)
#PIHOLE_MONITOR_UID=1000
#PIHOLE_MONITOR_GID=1000
